{
  "name": "link-to-screenshot",
  "version": "2.0.1",
  "description": "An npm package and CLI to capture website screenshots, HTML renders, and PDFs from any link or URL",
  "main": "src/index.js",
  "types": "index.d.ts",
  "bin": {
    "link-to-screenshot": "bin/cli.js"
  },
  "files": [
    "src",
    "bin",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "jest --runInBand --forceExit",
    "lint": "node -c src/*.js bin/*.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "screenshot",
    "link-to-screenshot",
    "website-screenshot",
    "url-screenshot",
    "puppeteer",
    "webpage-capture",
    "html-to-image",
    "pdf",
    "cli",
    "automation",
    "headless-chrome",
    "image",
    "render",
    "capture",
    "screenshot-api",
    "webpage",
    "chrome"
  ],
  "author": "Dipak",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sea-deep/link-to-screenshot.git"
  },
  "bugs": {
    "url": "https://github.com/sea-deep/link-to-screenshot/issues"
  },
  "homepage": "https://github.com/sea-deep/link-to-screenshot#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "puppeteer": "^22.5.0"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
